rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir que usuarios autenticados suban archivos a su carpeta personal
    match /logos/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Carpeta pública de cada usuario: todos leen, solo el dueño escribe (imágenes de hasta 5 MB).
    match /public/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && (request.resource == null
          || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp|gif)')));
    }
  }
}
