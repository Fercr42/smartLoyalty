# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Web Push: Firebase Console > Project settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server only: service account JSON en una sola linea (Project settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT=

# Google Wallet: Issuer ID de https://pay.google.com/business/console
GOOGLE_WALLET_ISSUER_ID=

# Apple Wallet (opcional; sin esto el botón no aparece en iPhone). Ver README, sección Apple Wallet.
# Los certificados van en PEM (con \n escritos como texto) o en base64.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERT=
APPLE_WALLET_KEY=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR=
# Texto largo al azar (mínimo 16 caracteres). No lo cambies después: los pases guardados dejarían de actualizarse.
APPLE_WALLET_AUTH_SECRET=

# PayPal (sandbox = pruebas, live = real)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Correos con acceso a /admin (separados por coma)
ADMIN_EMAILS=
