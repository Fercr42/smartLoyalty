# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Web Push: Firebase Console > Project settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server only: service account JSON en una sola linea (Project settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT=

# Google Wallet: Issuer ID de https://pay.google.com/business/console
GOOGLE_WALLET_ISSUER_ID=

# Apple Wallet (opcional; sin esto el botón no aparece en iPhone). Ver README, sección Apple Wallet.
# Los certificados van en PEM (con \n escritos como texto) o en base64.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERT=
APPLE_WALLET_KEY=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR=

# PayPal (sandbox = pruebas, live = real)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Un plan de PayPal por cada plan (créalos en PayPal con el precio mensual en USD: 39, 79 y 149).
# NEXT_PUBLIC_PAYPAL_PLAN_ID es el plan viejo de 100 USD: déjalo para quienes ya lo pagan.
NEXT_PUBLIC_PAYPAL_PLAN_ESENCIAL=
NEXT_PUBLIC_PAYPAL_PLAN_PRO=
NEXT_PUBLIC_PAYPAL_PLAN_MULTI=

# SINPE Móvil: número (8 dígitos) y nombre del titular que ven los negocios al pagar.
# Los pagos se aprueban en /admin; los avisos llegan a ADMIN_EMAILS (requiere RESEND_API_KEY).
SINPE_PHONE=
SINPE_NAME=

# Clave del cron (/api/cron/scheduled). Ponla igual en Vercel y en los secretos de GitHub Actions.
# Genera una con: openssl rand -hex 32
CRON_SECRET=

# Correos con acceso a /admin (separados por coma)
ADMIN_EMAILS=
