rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Datos públicos del restaurante (la página del QR los necesita). Solo el dueño edita.
    match /companies/{companyId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == companyId;

      // Clientes suscritos a push. El cliente (sin cuenta) solo puede registrar su token.
      // channel queda abierto a 'wallet' más adelante (escrito desde el servidor).
      match /subscribers/{token} {
        allow read, delete: if request.auth != null && request.auth.uid == companyId;
        allow create, update: if request.resource.data.keys().hasOnly(['token', 'channel', 'platform', 'createdAt'])
          && request.resource.data.token == token
          && request.resource.data.channel == 'webpush'
          && exists(/databases/$(database)/documents/companies/$(companyId));
      }

      // Historial de envíos. Solo lo escribe el servidor (Admin SDK).
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == companyId;
      }

      // Imágenes pesadas del restaurante (ej. portada de Wallet). Se sirven desde el servidor.
      match /assets/{assetId} {
        allow read, write: if request.auth != null && request.auth.uid == companyId;
      }

      // Historial de sellos y canjes. Solo lo escribe el servidor.
      match /loyaltyEvents/{eventId} {
        allow read: if request.auth != null && request.auth.uid == companyId;
      }

      // Clientes con tarjeta (sellos, Wallet). Solo los escribe el servidor.
      // companies/{id}/private/* (PIN de empleados) no tiene regla: nadie lo lee desde el navegador.
      match /walletMembers/{memberId} {
        allow read: if request.auth != null && request.auth.uid == companyId;
      }
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
